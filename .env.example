# Copie este arquivo para .env.local e preencha com os valores do
# seu projeto Supabase: Project Settings → API

# Pode ser exposta ao browser (prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon / public" — respeita Row Level Security, pode ser exposta ao browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — NUNCA prefixar com NEXT_PUBLIC_, nunca expor ao browser.
# Usada só em src/lib/supabase/admin-client.ts (painel admin, webhooks).
SUPABASE_SERVICE_ROLE_KEY=
